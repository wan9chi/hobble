{
  "package": {
    "name": "node-pty",
    "version": "1.2.0-beta.10"
  },
  "creance": "0.1.0",
  "lifecycle": "install",
  "entries": [
    {
      "os": [
        "darwin"
      ],
      "read": [
        "${HOME}/.vite-plus/**",
        "${HOME}/Library/**",
        "${PKG_DIR}",
        "${PKG_DIR}/build/Release",
        "${PKG_DIR}/node_modules/.bin/node",
        "${PKG_DIR}/package.json",
        "${PKG_DIR}/prebuilds/darwin-arm64",
        "${PKG_DIR}/scripts",
        "${PKG_DIR}/scripts/package.json",
        "${PKG_DIR}/scripts/post-install.js",
        "${PKG_DIR}/scripts/prebuild.js",
        "${PROJECT_ROOT}",
        "${PROJECT_ROOT}/node_modules",
        "${PROJECT_ROOT}/node_modules/.bin/node",
        "${PROJECT_ROOT}/node_modules/.pnpm",
        "${PROJECT_ROOT}/node_modules/.pnpm/node-pty@1.2.0-beta.10",
        "${PROJECT_ROOT}/node_modules/.pnpm/node-pty@1.2.0-beta.10/node_modules",
        "${PROJECT_ROOT}/node_modules/.pnpm/node-pty@1.2.0-beta.10/node_modules/.bin/node",
        "${PROJECT_ROOT}/node_modules/.pnpm/node_modules/.bin/node",
        "/",
        "/Volumes",
        "/Volumes/d",
        "/Volumes/d/code",
        "/Volumes/d/code/creance",
        "/Volumes/d/code/creance/e2e",
        "/Volumes/d/code/creance/e2e/fixtures",
        "/private/var/db/timezone/tz/2026b.1.0/zoneinfo/Asia/Shanghai"
      ],
      "write": [],
      "domains": []
    }
  ]
}