{
  "package": {
    "name": "esbuild",
    "version": "0.27.3"
  },
  "creance": "0.1.0",
  "lifecycle": "postinstall",
  "entries": [
    {
      "os": [
        "darwin"
      ],
      "read": [
        "${HOME}/.vite-plus/**",
        "${HOME}/Library/**",
        "${PKG_DIR}",
        "${PKG_DIR}/**",
        "${PROJECT_ROOT}",
        "${PROJECT_ROOT}/**",
        "/",
        "/Volumes",
        "/Volumes/d",
        "/Volumes/d/code",
        "/Volumes/d/code/creance",
        "/Volumes/d/code/creance/e2e",
        "/Volumes/d/code/creance/e2e/fixtures",
        "/private/var/db/timezone/tz/2026b.1.0/zoneinfo/Asia/Shanghai"
      ],
      "write": [],
      "domains": []
    }
  ]
}