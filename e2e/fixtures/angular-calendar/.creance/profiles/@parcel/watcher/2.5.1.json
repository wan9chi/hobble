{
  "package": {
    "name": "@parcel/watcher",
    "version": "2.5.1"
  },
  "creance": "0.1.0",
  "lifecycle": "install",
  "entries": [
    {
      "os": [
        "darwin"
      ],
      "read": [
        "${HOME}/.vite-plus/**",
        "${HOME}/Library/**",
        "${PKG_DIR}",
        "${PKG_DIR}/node_modules/**",
        "${PKG_DIR}/package.json",
        "${PKG_DIR}/scripts",
        "${PKG_DIR}/scripts/build-from-source.js",
        "${PKG_DIR}/scripts/package.json",
        "${PROJECT_ROOT}",
        "${PROJECT_ROOT}/**",
        "/",
        "/Volumes",
        "/Volumes/d",
        "/Volumes/d/code",
        "/Volumes/d/code/creance",
        "/Volumes/d/code/creance/e2e",
        "/Volumes/d/code/creance/e2e/fixtures",
        "/private/var/db/timezone/tz/2026b.1.0/zoneinfo/Asia/Shanghai"
      ],
      "write": [],
      "domains": []
    }
  ]
}